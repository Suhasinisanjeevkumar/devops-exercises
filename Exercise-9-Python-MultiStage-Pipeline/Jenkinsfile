pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        EXERCISE_DIR = 'Exercise-9-Python-MultiStage-Pipeline'
        VENV_DIR = '.venv-exercise-9'
        DEPLOY_DIR = 'python-app-deploy'
        APP_PORT = '5000'
    }

    stages {
        stage('Build') {
            steps {
                dir(env.EXERCISE_DIR) {
                    sh '''
                        set -eu

                        if command -v python3 >/dev/null 2>&1; then
                            PYTHON_BIN="$(command -v python3)"
                        elif command -v python >/dev/null 2>&1; then
                            PYTHON_BIN="$(command -v python)"
                        else
                            echo "ERROR: Python 3 was not found on the Jenkins agent PATH." >&2
                            exit 1
                        fi

                        echo "Using Python: $PYTHON_BIN"
                        "$PYTHON_BIN" --version
                        if ! "$PYTHON_BIN" -m pip --version; then
                            echo "ERROR: pip is unavailable for this Python interpreter." >&2
                            exit 1
                        fi

                        if ! "$PYTHON_BIN" -m venv "$WORKSPACE/$VENV_DIR"; then
                            echo "ERROR: Could not create the virtual environment. Check that Python's venv/ensurepip support is installed." >&2
                            exit 1
                        fi

                        VENV_PYTHON="$WORKSPACE/$VENV_DIR/bin/python"
                        "$VENV_PYTHON" --version
                        "$VENV_PYTHON" -m pip --version
                        if ! "$VENV_PYTHON" -m pip install --disable-pip-version-check -r requirements.txt; then
                            echo "ERROR: Dependency installation failed. Check Jenkins network access or configure an approved Python package index." >&2
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir(env.EXERCISE_DIR) {
                    sh '''
                        set -eu
                        "$WORKSPACE/$VENV_DIR/bin/python" -m unittest -v test_app
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    set -eu
                    mkdir -p "$WORKSPACE/$DEPLOY_DIR"
                    cp "$WORKSPACE/$EXERCISE_DIR/app.py" "$WORKSPACE/$DEPLOY_DIR/app.py"
                    test -f "$WORKSPACE/$DEPLOY_DIR/app.py"
                    echo "Deployed app.py to $WORKSPACE/$DEPLOY_DIR"
                '''
            }
        }

        stage('Run Application') {
            steps {
                sh '''
                    set -eu
                    cd "$WORKSPACE/$DEPLOY_DIR"
                    test -x "$WORKSPACE/$VENV_DIR/bin/python"
                    rm -f "app.pid.$BUILD_NUMBER" app.log
                    APP_PORT="$APP_PORT" nohup "$WORKSPACE/$VENV_DIR/bin/python" app.py > app.log 2>&1 < /dev/null &
                    echo "$!" > "app.pid.$BUILD_NUMBER"
                    echo "Started deployed application with PID $(cat "app.pid.$BUILD_NUMBER") on port $APP_PORT"
                '''
            }
        }

        stage('Test Application') {
            steps {
                sh '''
                    set -u
                    cd "$WORKSPACE/$DEPLOY_DIR"

                    if ! "$WORKSPACE/$VENV_DIR/bin/python" -c 'exec(__import__("textwrap").dedent("""
                        import os
                        import time
                        from urllib.error import HTTPError, URLError
                        from urllib.request import urlopen

                        url = f"http://127.0.0.1:{os.environ[\"APP_PORT\"]}/"
                        expected = "Hello, Jenkins Multi-Stage Pipeline!"
                        deadline = time.monotonic() + 30

                        while True:
                            try:
                                with urlopen(url, timeout=2) as response:
                                    body = response.read().decode("utf-8")
                                    if response.status != 200:
                                        raise SystemExit(
                                            f"FAIL: Expected HTTP 200, got {response.status}."
                                        )
                                    if body != expected:
                                        raise SystemExit(
                                            f"FAIL: Unexpected response body: {body!r}"
                                        )
                                    print(
                                        f"PASS: HTTP {response.status}; response body matches exactly."
                                    )
                                    break
                            except HTTPError as error:
                                raise SystemExit(
                                    f"FAIL: Application returned HTTP {error.code}."
                                ) from error
                            except (URLError, TimeoutError, ConnectionError) as error:
                                if time.monotonic() >= deadline:
                                    raise SystemExit(
                                        f"FAIL: Application did not become ready at {url}: {error}"
                                    ) from error
                                time.sleep(1)
                    """))'
                    then
                        echo "Application startup or HTTP verification failed. Application log follows:" >&2
                        if [ -f app.log ]; then
                            cat app.log >&2
                        fi
                        exit 1
                    fi
                '''
            }
        }
    }

    post {
        always {
            sh '''
                set -eu
                PID_FILE="$WORKSPACE/$DEPLOY_DIR/app.pid.$BUILD_NUMBER"
                if [ -f "$PID_FILE" ]; then
                    PID="$(cat "$PID_FILE")"
                    case "$PID" in
                        ''|*[!0-9]*)
                            echo "ERROR: Invalid application PID in $PID_FILE" >&2
                            exit 1
                            ;;
                    esac

                    if kill -0 "$PID" 2>/dev/null; then
                        kill "$PID"
                        for attempt in 1 2 3 4 5; do
                            if ! kill -0 "$PID" 2>/dev/null; then
                                break
                            fi
                            sleep 1
                        done
                        if kill -0 "$PID" 2>/dev/null; then
                            kill -KILL "$PID"
                        fi
                    fi
                    rm -f "$PID_FILE"
                    echo "Application process cleanup completed."
                else
                    echo "No deployed application process needed cleanup."
                fi
            '''
        }
        success {
            echo 'SUCCESS: Exercise 9 multi-stage pipeline completed successfully.'
        }
        failure {
            echo 'FAILURE: Exercise 9 pipeline failed. Review the stage output and Console Output.'
        }
    }
}
